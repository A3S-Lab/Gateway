mode { kind = "standalone" }

entrypoints "web" {
  address = "127.0.0.1:18081"
}

routers "benchmark" {
  rule        = "PathPrefix(`/`)"
  service     = "benchmark"
  entrypoints = ["web"]
}

services "benchmark" {
  load_balancer {
    strategy             = "round-robin"
    request_timeout      = "30s"
    stream_idle_timeout  = "30s"
    stream_total_timeout = "30s"
    servers = [{ url = "http://127.0.0.1:18080" }]
  }
}

observability {
  metrics_enabled    = false
  access_log_enabled = false
  tracing_enabled    = false
}
