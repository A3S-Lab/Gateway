mode { kind = "standalone" }

entrypoints "ai" {
  address = "127.0.0.1:18101"
}

# Readiness must not depend on the intentionally dead primary.
# Explicit priority beats PathPrefix(`/`) (same rule-length default).
routers "health" {
  rule        = "Path(`/health`)"
  service     = "ai-benchmark-backup"
  entrypoints = ["ai"]
  priority    = 100
}

routers "ai-benchmark" {
  rule        = "PathPrefix(`/`)"
  service     = "ai-benchmark"
  entrypoints = ["ai"]
}

# Primary points at a closed port. After passive health quarantine
# (default threshold 5), FailoverSelector routes to the backup pool.
services "ai-benchmark" {
  load_balancer {
    strategy             = "round-robin"
    request_timeout      = "30s"
    stream_idle_timeout  = "30s"
    stream_total_timeout = "30s"
    connect_timeout      = "2s"
    servers = [{ url = "http://127.0.0.1:18199" }]
  }
  failover {
    service = "ai-benchmark-backup"
  }
}

services "ai-benchmark-backup" {
  load_balancer {
    strategy             = "round-robin"
    request_timeout      = "120s"
    stream_idle_timeout  = "120s"
    stream_total_timeout = "120s"
    servers = [{ url = "http://127.0.0.1:18100" }]
  }
}

observability {
  metrics_enabled    = false
  access_log_enabled = false
  tracing_enabled    = false
}
